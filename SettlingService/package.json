{
  "name": "settle-service",
  "version": "1.0.0",
  "description": "Settlement Service",
  "private": true,
  "scripts": {
    "build:remote": "cross-env NODE_ENV=production webpack --config webpack.config.js",
    "build:remote:dev": "cross-env NODE_ENV=development webpack --config webpack.config.js",
    "watch:remote": "cross-env NODE_ENV=development webpack --config webpack.config.js --watch",
    "dev": "npm run watch:remote",
    "build:prod": "npm run build:remote"
  },
  "dependencies": {
    "antd": "^6.0.0",
    "dayjs": "^1.11.19",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.22.0",
    "babel-loader": "^9.1.3",
    "cross-env": "^7.0.3",
    "css-loader": "^6.8.1",
    "style-loader": "^3.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  }
}
