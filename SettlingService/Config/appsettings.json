  //Config cho Kafka (service hiện chưa dùng tới)
  "KafkaConfig": {
    "KafkaFolderLogSend": "SendKafka",
    "KafkaFolderLogReceive": "ReceiveKafka",
    "KafkaAuth": "false", // true: bật auth, false: tắt auth
